# SODA Canvas v0.1 — Marco V
# Isola TUDO (store, cache, state) dentro do DevDrive Z:
# para evitar EPERM da sandbox TRAE em Z:\.pnpm-store e
# C:\Users\rosas\AppData\Local\pnpm-cache.
#
# `node-linker=hoisted` = node_modules flat estilo npm (Tauri/Vite
# esperam isso; sem symlinks em Windows DevDrive).
node-linker=hoisted
store-dir=./.pnpm-store
cache-dir=./.pnpm-cache
state-dir=./.pnpm-state

